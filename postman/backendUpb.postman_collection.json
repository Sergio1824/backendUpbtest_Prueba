{
    "info":  {
                 "name":  "backendUpb - Productos",
                 "description":  "CRUD de productos, cálculo del carrito y compra confirmada (Express + PostgreSQL) desplegados en Render.",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "variable":  [
                     {
                         "key":  "baseUrl",
                         "value":  "https://backendupbtest-prueba.onrender.com",
                         "description":  "Producción (Render)"
                     },
                     {
                         "key":  "localUrl",
                         "value":  "http://localhost:3001",
                         "description":  "Local: copia este valor en baseUrl para probar en tu PC"
                     },
                     {
                         "key":  "id",
                         "value":  "2",
                         "description":  "Id del producto a consultar, actualizar o eliminar"
                     },
                     {
                         "key":  "purchaseId",
                         "value":  "",
                         "description":  "Se actualiza al ejecutar Confirmar compra"
                     }
                 ],
    "item":  [
                 {
                     "name":  "Health check",
                     "request":  {
                                     "method":  "GET",
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/health",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "health"
                                                          ]
                                             }
                                 }
                 },
                 {
                     "name":  "Listar productos",
                     "request":  {
                                     "method":  "GET",
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/productos",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "productos"
                                                          ]
                                             }
                                 }
                 },
                 {
                     "name":  "Buscar productos por nombre",
                     "request":  {
                                     "method":  "GET",
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/productos?nombre=prueba",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "productos"
                                                          ],
                                                 "query":  [
                                                               {
                                                                   "key":  "nombre",
                                                                   "value":  "prueba",
                                                                   "description":  "Texto a buscar (no distingue mayúsculas)"
                                                               }
                                                           ]
                                             }
                                 }
                 },
                 {
                     "name":  "Obtener producto por id",
                     "request":  {
                                     "method":  "GET",
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/productos/{{id}}",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "productos",
                                                              "{{id}}"
                                                          ]
                                             }
                                 }
                 },
                 {
                     "name":  "Crear producto",
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "if (pm.response.code === 201) {",
                                                                   "    pm.collectionVariables.set(\u0027id\u0027, pm.response.json().id);",
                                                                   "}"
                                                               ]
                                                  }
                                   }
                               ],
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n    \"nombre\": \"Laptop\",\n    \"precio\": 1500,\n    \"stock\": 5\n}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              }
                                              },
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/productos",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "productos"
                                                          ]
                                             }
                                 }
                 },
                 {
                     "name":  "Actualizar producto",
                     "request":  {
                                     "method":  "PUT",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n    \"precio\": 1350,\n    \"stock\": 10\n}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              }
                                              },
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/productos/{{id}}",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "productos",
                                                              "{{id}}"
                                                          ]
                                             }
                                 }
                 },
                 {
                     "name":  "Eliminar producto",
                     "request":  {
                                     "method":  "DELETE",
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/productos/{{id}}",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "productos",
                                                              "{{id}}"
                                                          ]
                                             }
                                 }
                 },
                 {
                     "name":  "Crear producto inválido (400)",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n    \"precio\": -10\n}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              }
                                              },
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/productos",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "productos"
                                                          ]
                                             }
                                 }
                 },
                 {
                     "name":  "Calcular carrito (sin guardar compra)",
                     "request":  {
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/carrito/calcular",
                                                 "path":  [
                                                              "api",
                                                              "carrito",
                                                              "calcular"
                                                          ]
                                             },
                                     "method":  "POST",
                                     "body":  {
                                                  "raw":  "{\"items\":[{\"productoId\":{{id}},\"cantidad\":2}]}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              },
                                                  "mode":  "raw"
                                              },
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 }
                 },
                 {
                     "name":  "Confirmar compra (guarda y descuenta stock)",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "if (pm.response.code === 201) {",
                                                                   "    pm.collectionVariables.set(\u0027purchaseId\u0027, pm.response.json().id);",
                                                                   "}"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ],
                     "request":  {
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/compras",
                                                 "path":  [
                                                              "api",
                                                              "compras"
                                                          ]
                                             },
                                     "method":  "POST",
                                     "body":  {
                                                  "raw":  "{\"items\":[{\"productoId\":{{id}},\"cantidad\":1}]}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              },
                                                  "mode":  "raw"
                                              },
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 }
                 },
                 {
                     "name":  "Consultar compra confirmada",
                     "request":  {
                                     "method":  "GET",
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/compras/{{purchaseId}}",
                                                 "path":  [
                                                              "api",
                                                              "compras",
                                                              "{{purchaseId}}"
                                                          ]
                                             }
                                 }
                 }
             ]
}